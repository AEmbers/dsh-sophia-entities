// Emit configuration for the ported DAG-team half. See tsconfig.json beside this
// file for why `exactOptionalPropertyTypes` is relaxed for this package only:
// the tree is upstream @nanmicoder/dsh-agent-teams 0.1.21, kept verbatim.
{
  "extends": "../../tsconfig.build-deps.json",
  "include": ["src"],
  "compilerOptions": {
    "exactOptionalPropertyTypes": false,
    "noEmit": false,
    "rootDir": "src",
    "outDir": "lib",
    "declaration": true,
    "declarationMap": true,
    "declarationDir": "lib/types"
  }
}
